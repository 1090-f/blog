# Copy this file to .env before starting Docker Compose. Do not commit .env.
MYSQL_DATABASE=gin_blog
MYSQL_USER=blog
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use a long, randomly generated value in production.
BLOG_JWT_SECRET=replace-with-a-long-random-jwt-secret
BLOG_JWT_EXPIRE=7200
BLOG_UPLOAD_MAX_SIZE_BYTES=5242880

# Host ports. The public site is read-only; publish and image upload use the admin port.
# Change these if 8080 or 8081 is already in use.
PUBLIC_PORT=8080
ADMIN_PORT=8081

# Leave disabled after the first administrator has been created.
BLOG_ADMIN_BOOTSTRAP_ENABLED=true
BLOG_ADMIN_BOOTSTRAP_USERNAME=admin
BLOG_ADMIN_BOOTSTRAP_PASSWORD=123456
BLOG_ADMIN_BOOTSTRAP_NICKNAME=admin
